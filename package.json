{
  "name": "overlay-app",
  "private": true,
  "version": "1.1.2",
  "description": "Overlay dynamic command center",
  "author": "Pradhan",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "tsc && vite build && electron-builder"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.pradhan.overlay",
    "productName": "Overlay",
    "directories": {
      "output": "C:\\Users\\SOURADEEP\\overlay-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "applogo.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "pradhan-not-found",
      "repo": "Overlay-"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "loudness": "^0.4.2",
    "lucide": "^1.28.0",
    "systeminformation": "^5.33.1",
    "windows-media-sessions": "^1.0.3"
  }
}
